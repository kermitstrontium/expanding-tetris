[Unit]
Description=Expanding Tetris static site (tailnet :9447 -> 127.0.0.1:8091)
Documentation=file://%h/ai-share/expanding-tetris/README.md
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ai-share/expanding-tetris
ExecStart=/usr/bin/python3 %h/ai-share/expanding-tetris/serve.py --port 8091 --bind 127.0.0.1
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
